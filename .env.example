# ============================================================================
# Discord Crypto Escrow Bot — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
HEALTH_CHECK_PORT=3000

# --- Discord -----------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# --- Database ----------------------------------------------------------------
# Dev (SQLite, zero setup):
DATABASE_URL="file:./prisma/dev.db"
# Prod (Postgres via docker-compose): DATABASE_URL is overridden by docker-compose.yml
# using POSTGRES_PASSWORD below; you don't need to set it by hand for docker compose.
POSTGRES_PASSWORD=

# --- Litecoin ------------------------------------------------------------------
LTC_NETWORK=mainnet
# Tatum free tier: https://tatum.io (dashboard -> API key). Required.
TATUM_API_KEY=
LTC_FEE_WALLET_ADDRESS=
LTC_REQUIRED_CONFIRMATIONS=3

# --- Solana ----------------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional secondary/failover RPC endpoint (e.g. Helius free tier)
SOLANA_RPC_URL_FALLBACK=
SOL_FEE_WALLET_ADDRESS=

# --- USDT (Polygon) ----------------------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
# Optional secondary/failover RPC endpoint (e.g. Alchemy/Infura free tier)
POLYGON_RPC_URL_FALLBACK=
# Leave as the default unless you have a genuine reason to point elsewhere
USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
USDT_FEE_WALLET_ADDRESS=
USDT_REQUIRED_CONFIRMATIONS=30

# --- Fees --------------------------------------------------------------------------
# Basis points, e.g. 250 = 2.5%
FEE_BASIS_POINTS=250

# --- Roles (all optional — the bot works with none of these set) -------------------
# Discord role IDs allowed to run admin commands (/freeze /unfreeze /release /refund
# /cancel /override-payout). Comma-separated. A real Discord "Administrator" always
# has admin access regardless of this list, so you do NOT need to set this just to
# get started — only set it if you want to grant admin access more narrowly than that.
ADMIN_ROLE_IDS=
# Automatically assigned to the buyer/seller when a deal completes. Leave blank to skip.
BUYER_COMPLETED_ROLE_ID=
SELLER_COMPLETED_ROLE_ID=
# Discord category ID new deal ticket channels are created under. Leave blank to create
# them at the top level of the server.
ESCROW_CATEGORY_ID=

# --- Scheduler -----------------------------------------------------------------------
DEPOSIT_SCAN_CRON=*/2 * * * *

# --- Backup ------------------------------------------------------------------------
# Directory for a second, independent JSON copy of every active deal + wallet,
# written on every save — recoverable via `npm run restore:backup` even if the
# database itself is destroyed. Leave blank to use the default "./backups".
BACKUP_DIR=./backups
