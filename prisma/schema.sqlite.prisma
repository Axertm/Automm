generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deal {
  id                              String   @id @default(cuid())
  guildId                         String
  ticketChannelId                 String   @unique
  currency                        String
  state                           String
  buyerDiscordId                  String
  sellerDiscordId                 String
  expectedAmount                  String
  feeBasisPointsSnapshot          Int
  payoutAddress                   String?
  payoutAddressConfirmedBySeller  Boolean  @default(false)
  buyerReleaseConfirmed           Boolean  @default(false)
  payoutAddressOverriddenByAdmin  Boolean  @default(false)
  payoutOverrideReason            String?
  payoutOverrideByDiscordId       String?
  frozenFromState                 String?
  frozenReason                    String?
  frozenByDiscordId               String?
  cancelReason                    String?
  refundReason                    String?
  refundAddress                   String?
  payoutFeeTxId                   String?
  payoutMainTxId                  String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  fundedAt                        DateTime?
  completedAt                     DateTime?

  wallet       Wallet?
  transactions Transaction[]
  auditEntries AuditEntry[]
  parties      Party[]
  backups      DealBackup[]

  @@index([state])
  @@index([guildId])
}

model Wallet {
  id                  String   @id @default(cuid())
  dealId              String   @unique
  deal                Deal     @relation(fields: [dealId], references: [id])
  currency            String
  address             String   @unique
  encryptedPrivateKey String
  derivationPath      String?
  createdAt           DateTime @default(now())
}

model Transaction {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id])
  txid          String
  direction     String
  status        String
  currency      String
  amount        String
  confirmations Int       @default(0)
  detectedAt    DateTime  @default(now())
  confirmedAt   DateTime?

  @@unique([dealId, txid, direction])
  @@index([status])
}

model AuditEntry {
  id        String   @id @default(cuid())
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  actorId   String
  action    String
  fromState String?
  toState   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([createdAt])
}

model Party {
  id             String  @id @default(cuid())
  dealId         String
  deal           Deal    @relation(fields: [dealId], references: [id])
  discordUserId  String
  role           String
  completedFlag  Boolean @default(false)

  @@unique([dealId, discordUserId, role])
}

// A user-registered alternate Discord account that can stand in for them.
// Global/reusable across deals — registering one here does not, by itself,
// grant it access to anything; an admin must separately activate it on a
// specific deal (see DealBackup) before it can act.
model BackupAccount {
  id              String   @id @default(cuid())
  ownerDiscordId  String
  backupDiscordId String
  createdAt       DateTime @default(now())

  @@unique([ownerDiscordId, backupDiscordId])
  @@index([ownerDiscordId])
}

// Activates one of a party's registered BackupAccount entries for a specific
// deal + role, granting it the same buyer/seller permissions as the real
// party for that deal only. Admin-only to create (see resolveActingDiscordId
// for how it's consulted) — the two-step model (user registers, admin
// activates per-deal) means an admin can never unilaterally hand deal access
// to an account the real party hasn't already vouched for.
model DealBackup {
  id              String   @id @default(cuid())
  dealId          String
  deal            Deal     @relation(fields: [dealId], references: [id])
  role            String
  backupDiscordId String
  addedByAdminId  String
  createdAt       DateTime @default(now())

  @@unique([dealId, role])
  @@index([dealId])
}

// A user's default payout address per currency, so future deals can offer
// "use your saved address" instead of asking them to retype it. Populated
// automatically whenever SubmitPayoutAddressUseCase succeeds.
model SavedPayoutAddress {
  id            String   @id @default(cuid())
  discordUserId String
  currency      String
  address       String
  updatedAt     DateTime @updatedAt

  @@unique([discordUserId, currency])
}

model GuildConfig {
  id                    String   @id @default(cuid())
  guildId               String   @unique
  buyerCompletedRoleId  String?
  sellerCompletedRoleId String?
  escrowCategoryId      String?
  feeWalletLtc          String
  feeWalletSol          String
  feeBasisPoints        Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  adminRoles GuildAdminRole[]
}

model GuildAdminRole {
  id            String      @id @default(cuid())
  guildId       String
  roleId        String
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId])

  @@unique([guildId, roleId])
}
