// ============================================================================
// Canonical Prisma schema — source of truth, targets PostgreSQL (production).
//
// SQLite/Postgres parity note: every enum-like column is a plain `String`
// (Prisma native `enum` is unsupported on SQLite), validated by Zod/domain
// value objects at the repository boundary rather than by the DB engine.
// Money/amount fields are decimal strings for the same reason, converted to
// the domain `Money` value object's internal bigint at the boundary.
//
// Prisma requires a single static `provider` per generated client — it
// cannot be swapped via env var. `npm run dev` mechanically derives
// prisma/schema.sqlite.prisma from this file (see scripts/generate-sqlite-schema.mjs)
// for zero-setup local development. NEVER hand-edit schema.sqlite.prisma —
// this file is the only one anyone should edit.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Deal {
  id                              String   @id @default(cuid())
  guildId                         String
  ticketChannelId                 String   @unique
  currency                        String
  state                           String
  buyerDiscordId                  String
  sellerDiscordId                 String
  expectedAmount                  String
  feeBasisPointsSnapshot          Int
  payoutAddress                   String?
  payoutAddressConfirmedBySeller  Boolean  @default(false)
  buyerReleaseConfirmed           Boolean  @default(false)
  payoutAddressOverriddenByAdmin  Boolean  @default(false)
  payoutOverrideReason            String?
  payoutOverrideByDiscordId       String?
  frozenFromState                 String?
  frozenReason                    String?
  frozenByDiscordId               String?
  cancelReason                    String?
  refundReason                    String?
  refundAddress                   String?
  payoutFeeTxId                   String?
  payoutMainTxId                  String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  fundedAt                        DateTime?
  completedAt                     DateTime?

  wallet       Wallet?
  transactions Transaction[]
  auditEntries AuditEntry[]
  parties      Party[]

  @@index([state])
  @@index([guildId])
}

model Wallet {
  id                  String   @id @default(cuid())
  dealId              String   @unique
  deal                Deal     @relation(fields: [dealId], references: [id])
  currency            String
  address             String   @unique
  encryptedPrivateKey String
  derivationPath      String?
  createdAt           DateTime @default(now())
}

model Transaction {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id])
  txid          String
  direction     String
  status        String
  currency      String
  amount        String
  confirmations Int       @default(0)
  detectedAt    DateTime  @default(now())
  confirmedAt   DateTime?

  @@unique([dealId, txid, direction])
  @@index([status])
}

model AuditEntry {
  id        String   @id @default(cuid())
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id])
  actorId   String
  action    String
  fromState String?
  toState   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([dealId])
  @@index([createdAt])
}

model Party {
  id             String  @id @default(cuid())
  dealId         String
  deal           Deal    @relation(fields: [dealId], references: [id])
  discordUserId  String
  role           String
  completedFlag  Boolean @default(false)

  @@unique([dealId, discordUserId, role])
}

model GuildConfig {
  id                    String   @id @default(cuid())
  guildId               String   @unique
  buyerCompletedRoleId  String?
  sellerCompletedRoleId String?
  escrowCategoryId      String?
  feeWalletLtc          String
  feeWalletSol          String
  feeBasisPoints        Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  adminRoles GuildAdminRole[]
}

model GuildAdminRole {
  id            String      @id @default(cuid())
  guildId       String
  roleId        String
  guildConfig   GuildConfig @relation(fields: [guildId], references: [guildId])

  @@unique([guildId, roleId])
}
